<?xml version="1.0" encoding="utf-8"?>
<!-- Seguridad: prohíbe el tráfico HTTP sin cifrar (protege contra MITM). Solo HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
